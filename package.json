{
  "name": "iris-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-tenant e-commerce & goods trading platform (PayloadCMS, NestJS, React)",
  "author": {
    "name": "Andrii Yermolenko",
    "email": "andriy.ermolenko@gmail.com"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:admin": "npm run dev --workspace=iris-admin",
    "dev:api": "npm run dev --workspace=iris-api",
    "dev:app": "npm run dev --workspace=iris-app",
    "build": "npm run build --workspace=@iris/shared && npm run build --workspace=iris-api && npm run build --workspace=iris-app && npm run build --workspace=iris-admin",
    "build:shared": "npm run build --workspace=@iris/shared",
    "build:admin": "npm run build --workspace=iris-admin",
    "build:api": "npm run build --workspace=iris-api",
    "build:app": "npm run build --workspace=iris-app",
    "migrate": "npm run migrate --workspace=iris-api",
    "seed": "npm run seed --workspace=iris-api",
    "test": "npm run test --workspace=iris-api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
