{
  "name": "iris-api",
  "version": "2.0.0",
  "private": true,
  "description": "NestJS Backend API for Iris Multi-Tenant Storefront & CRM",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "ts-node src/scripts/migrate-tenants.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "test": "node --test dist/test/*.spec.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@iris/shared": "*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/mongoose": "^11.0.2",
    "@nestjs/platform-express": "^11.0.10",
    "dotenv": "^16.4.7",
    "mongoose": "^8.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
